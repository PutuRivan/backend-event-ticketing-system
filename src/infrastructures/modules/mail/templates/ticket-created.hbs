<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <title>Your Event Ticket</title>
    </head>

    <body>
        <h1>Your Ticket is Ready 🎟️</h1>

        <p>Hi {{name}},</p>

        <p>
            Thank you for your purchase. Your ticket has been successfully
            generated.
        </p>

        <h2>Event Details</h2>

        <p>
            <strong>Event:</strong>
            {{eventName}}
        </p>

        <p>
            <strong>Date:</strong>
            {{eventDate}}
        </p>

        <p>
            <strong>Location:</strong>
            {{location}}
        </p>

        <p>
            <strong>Ticket Quantity:</strong>
            {{quantity}}
        </p>

        <p>
            <strong>Ticket NUmber:</strong>
            {{ticketNumber}}
        </p>

        <p>
            Your ticket PDF is attached to this email. Please bring the ticket
            and QR code during the event check-in.
        </p>

        <p>
            Enjoy the event!
        </p>

        <p>
            Regards,<br />
            Event Ticketing Team
        </p>
    </body>
</html>